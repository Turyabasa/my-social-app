# Used by docker-compose.yml. Copy to .env and replace the values:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=change-me-local-db-password
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# Host ports (change if something else already uses them).
FRONTEND_PORT=3000
BACKEND_PORT=8000
