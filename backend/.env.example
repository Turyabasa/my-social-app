# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
# postgres://, postgresql:// and postgresql+asyncpg:// are all accepted; ?sslmode=require is supported (Neon).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/social
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000
# Set COOKIE_SECURE=true in production (HTTPS).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
